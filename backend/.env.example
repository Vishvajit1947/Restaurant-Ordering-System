# Copy to .env and adjust. All values have safe development defaults.
ENV=dev
DATABASE_URL=postgresql+psycopg://restaurant:restaurant@localhost:5433/restaurant
TEST_DATABASE_URL=postgresql+psycopg://restaurant:restaurant@localhost:5433/restaurant_test
# REQUIRED outside dev: a long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me-in-production-please-32b
JWT_EXPIRE_MINUTES=480
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
MEDIA_DIR=media
TIMEZONE=Asia/Kolkata
